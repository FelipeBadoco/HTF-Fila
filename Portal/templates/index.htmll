<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Fila de Processamento HTF</title>
    <link href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <link sizes="120x120" href="https://santacasabraganca.com.br/_shared/images/favicon/apple-icon-120x120.png">
    
    <style>
        :root {
            --primary-color: #00305d;
            --secondary-color: #0056b3;
            --success-color: #28a745;
            --warning-color: #ffc107;
            --danger-color: #dc3545;
            --info-color: #17a2b8;
            --light-bg: #f8f9fa;
            --white: #ffffff;
            --text-muted: #6c757d;
            --shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
            --border-radius: 8px;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
            min-height: 100vh;
        }

        .navbar {
            background: linear-gradient(135deg, var(--primary-color) 0%, var(--secondary-color) 100%);
            box-shadow: var(--shadow);
            border: none;
        }

        .navbar-brand img {
            max-width: 250px;
            transition: transform 0.3s ease;
        }

        .navbar-brand img:hover {
            transform: scale(1.05);
        }

        .container {
            max-width: 95%;
            margin-top: 20px;
        }

        .page-header {
            background: var(--white);
            padding: 30px;
            border-radius: var(--border-radius);
            box-shadow: var(--shadow);
            margin-bottom: 30px;
            text-align: center;
            border-left: 5px solid var(--primary-color);
        }

        .page-header h2 {
            color: var(--primary-color);
            font-weight: 600;
            margin-bottom: 10px;
        }

        .page-header .subtitle {
            color: var(--text-muted);
            font-size: 1.1rem;
        }

        .alert {
            font-size: 1.1rem;
            border-radius: var(--border-radius);
            box-shadow: var(--shadow);
            border: none;
            margin-bottom: 20px;
        }

        .alert-danger {
            background: linear-gradient(135deg, #ff6b6b 0%, #ee5a24 100%);
            color: var(--white);
        }

        .alert-warning {
            background: linear-gradient(135deg, #feca57 0%, #ff9ff3 100%);
            color: #333;
        }

        .stats-cards {
            display: flex;
            gap: 20px;
            margin-bottom: 30px;
            flex-wrap: wrap;
        }

        .stat-card {
            flex: 1;
            min-width: 200px;
            background: var(--white);
            padding: 25px;
            border-radius: var(--border-radius);
            box-shadow: var(--shadow);
            text-align: center;
            border-top: 4px solid var(--primary-color);
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }

        .stat-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 8px 25px rgba(0, 0, 0, 0.15);
        }

        .stat-card .icon {
            font-size: 2.5rem;
            color: var(--primary-color);
            margin-bottom: 15px;
        }

        .stat-card .number {
            font-size: 2rem;
            font-weight: bold;
            color: var(--primary-color);
            margin-bottom: 5px;
        }

        .stat-card .label {
            color: var(--text-muted);
            font-size: 0.95rem;
            font-weight: 500;
        }

        .table-container {
            background: var(--white);
            border-radius: var(--border-radius);
            box-shadow: var(--shadow);
            overflow: hidden;
            margin-bottom: 30px;
        }

        .table-header {
            background: linear-gradient(135deg, var(--primary-color) 0%, var(--secondary-color) 100%);
            color: var(--white);
            padding: 20px;
            border-bottom: none;
        }

        .table-header h4 {
            margin: 0;
            font-weight: 600;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .table {
            margin-bottom: 0;
            background: var(--white);
        }

        .table thead th {
            background: linear-gradient(135deg, var(--primary-color) 0%, var(--secondary-color) 100%);
            color: var(--white);
            border: none;
            font-weight: 600;
            text-align: center;
            padding: 15px;
            font-size: 0.95rem;
        }

        .table tbody tr {
            transition: all 0.3s ease;
        }

        .table tbody tr:hover {
            background-color: #f8f9ff;
            transform: scale(1.01);
        }

        .table td {
            text-align: center;
            padding: 15px;
            vertical-align: middle;
            border-color: #e9ecef;
        }

        .status-badge {
            padding: 8px 16px;
            border-radius: 20px;
            font-size: 0.85rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .status-processing {
            background: linear-gradient(135deg, #74b9ff 0%, #0984e3 100%);
            color: var(--white);
            animation: pulse 2s infinite;
        }

        .status-completed {
            background: linear-gradient(135deg, #55efc4 0%, #00b894 100%);
            color: var(--white);
        }

        .status-pending {
            background: linear-gradient(135deg, #fdcb6e 0%, #e17055 100%);
            color: var(--white);
        }

        .status-error {
            background: linear-gradient(135deg, #fd79a8 0%, #e84393 100%);
            color: var(--white);
        }

        .progress-bar-custom {
            height: 8px;
            background: #e9ecef;
            border-radius: 4px;
            overflow: hidden;
            position: relative;
        }

        .progress-fill {
            height: 100%;
            background: linear-gradient(90deg, var(--success-color) 0%, #20c997 100%);
            border-radius: 4px;
            transition: width 0.5s ease;
            position: relative;
        }

        .progress-fill::after {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            height: 100%;
            width: 100%;
            background: linear-gradient(90deg, transparent, rgba(255,255,255,0.3), transparent);
            animation: shimmer 2s infinite;
        }

        @keyframes pulse {
            0% { box-shadow: 0 0 0 0 rgba(116, 185, 255, 0.7); }
            70% { box-shadow: 0 0 0 10px rgba(116, 185, 255, 0); }
            100% { box-shadow: 0 0 0 0 rgba(116, 185, 255, 0); }
        }

        @keyframes shimmer {
            0% { transform: translateX(-100%); }
            100% { transform: translateX(100%); }
        }

        .footer {
            text-align: center;
            margin-top: 40px;
            padding: 20px;
            background: var(--white);
            border-radius: var(--border-radius);
            box-shadow: var(--shadow);
            color: var(--text-muted);
        }

        .refresh-indicator {
            position: fixed;
            top: 20px;
            right: 20px;
            background: var(--primary-color);
            color: var(--white);
            padding: 10px 20px;
            border-radius: 20px;
            font-size: 0.9rem;
            box-shadow: var(--shadow);
            z-index: 1000;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .refresh-indicator i {
            animation: rotate 2s linear infinite;
        }

        @keyframes rotate {
            from { transform: rotate(0deg); }
            to { transform: rotate(360deg); }
        }

        .no-data {
            text-align: center;
            padding: 60px 20px;
            color: var(--text-muted);
        }

        .no-data i {
            font-size: 4rem;
            margin-bottom: 20px;
            opacity: 0.5;
        }

        @media (max-width: 768px) {
            .stats-cards {
                flex-direction: column;
            }
            
            .container {
                max-width: 98%;
                padding: 0 10px;
            }
            
            .table-responsive {
                font-size: 0.85rem;
            }
            
            .page-header {
                padding: 20px;
            }
        }
    </style>
</head>
<body>
    <div class="refresh-indicator">
        <i class="fas fa-sync-alt"></i>
        Atualizando...
    </div>

    <nav class="navbar navbar-expand-lg navbar-dark">
        <div class="container">
            <a class="navbar-brand" href="#">
                <img src="https://santacasabraganca.com.br/assets/images/logo.png" alt="Logo Santa Casa Bragança">
            </a>
        </div>
    </nav>

    <div class="container">
        <div class="page-header">
            <h2><i class="fas fa-tasks"></i> Fila de Processamento HTF</h2>
            <p class="subtitle">Monitoramento em tempo real do sistema de processamento</p>
        </div>

        {% if mensagem_servico %}
            <div class="alert alert-danger">
                <i class="fas fa-exclamation-triangle"></i>
                <strong>Atenção!</strong> {{ mensagem_servico }}
            </div>
        {% endif %}

        {% if mensagem %}
            <div class="alert alert-warning">
                <i class="fas fa-info-circle"></i>
                <strong>Aviso:</strong> {{ mensagem }}
            </div>
        {% endif %}

        <div class="stats-cards">
            <div class="stat-card">
                <div class="icon">
                    <i class="fas fa-file-alt"></i>
                </div>
                <div class="number" id="total-paginas">{{ total_paginas or 0 }}</div>
                <div class="label">Páginas Digitalizadas</div>
            </div>
            <div class="stat-card">
                <div class="icon">
                    <i class="fas fa-briefcase"></i>
                </div>
                <div class="number" id="total-trabalhos">{{ total_trabalhos or 0 }}</div>
                <div class="label">Total de Trabalhos</div>
            </div>
            <div class="stat-card">
                <div class="icon">
                    <i class="fas fa-clock"></i>
                </div>
                <div class="number" id="processando">
                    {% set processando = 0 %}
                    {% for item in dados %}
                        {% if 'process' in item.State.lower() %}
                            {% set processando = processando + 1 %}
                        {% endif %}
                    {% endfor %}
                    {{ processando }}
                </div>
                <div class="label">Em Processamento</div>
            </div>
        </div>

        <div class="table-container">
            <div class="table-header">
                <h4><i class="fas fa-list"></i> Fila de Processamento</h4>
            </div>
            <div class="table-responsive">
                <table class="table table-striped" id="dados-tabela">
                    <thead>
                        <tr>
                            <th><i class="fas fa-file"></i> Nome</th>
                            <th><i class="fas fa-info-circle"></i> Status</th>
                            <th><i class="fas fa-percentage"></i> Progresso</th>
                            <th><i class="fas fa-copy"></i> Páginas</th>
                            <th><i class="fas fa-user"></i> Usuário</th>
                            <th><i class="fas fa-globe"></i> Site</th>
                            <th><i class="fas fa-clock"></i> Hora</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% if dados %}
                            {% for item in dados %}
                            <tr>
                                <td><strong>{{ item.Name or 'N/A' }}</strong></td>
                                <td>
                                    {% set status_class = 'status-pending' %}
                                    {% if item.State %}
                                        {% set state_lower = item.State.lower() %}
                                        {% if 'process' in state_lower %}
                                            {% set status_class = 'status-processing' %}
                                        {% elif 'conclu' in state_lower or 'complete' in state_lower or 'finaliz' in state_lower %}
                                            {% set status_class = 'status-completed' %}
                                        {% elif 'erro' in state_lower or 'error' in state_lower or 'falha' in state_lower %}
                                            {% set status_class = 'status-error' %}
                                        {% endif %}
                                    {% endif %}
                                    <span class="status-badge {{ status_class }}">{{ item.State or 'Desconhecido' }}</span>
                                </td>
                                <td>
                                    <div class="progress-bar-custom">
                                        <div class="progress-fill" style="width: {{ item.Percentage or 0 }}%"></div>
                                    </div>
                                    <small class="text-muted">{{ item.Percentage or 0 }}%</small>
                                </td>
                                <td><span class="badge badge-info">{{ item.Pages or 0 }}</span></td>
                                <td>{{ item.User or 'N/A' }}</td>
                                <td>{{ item.Site or 'N/A' }}</td>
                                <td>{{ item.Time or 'N/A' }}</td>
                            </tr>
                            {% endfor %}
                        {% else %}
                            <tr>
                                <td colspan="7" class="text-center text-muted py-5">
                                    <i class="fas fa-inbox fa-3x mb-3" style="opacity: 0.3;"></i>
                                    <br>
                                    Nenhum trabalho na fila de processamento
                                </td>
                            </tr>
                        {% endif %}
                    </tbody>
                </table>
            </div>
        </div>

        {% if not dados %}
        <div class="no-data">
            <i class="fas fa-inbox"></i>
            <h4>Nenhum trabalho na fila</h4>
            <p>{{ mensagem or 'Não há trabalhos de processamento no momento.' }}</p>
        </div>
        {% endif %}
    </div>

    <div class="footer">
        <p><i class="fas fa-hospital"></i> Sistema de Processamento HTF - Santa Casa Bragança</p>
        <p><small>Atualização automática a cada segundo</small></p>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.5.2/dist/js/bootstrap.bundle.min.js"></script>
    
    <script>
        // Auto-refresh da página a cada 1 segundo
        setTimeout(function() {
            location.reload();
        }, 1000);

        // Smooth scroll para tabela quando houver muitos itens
        window.addEventListener('load', function() {
            const table = document.querySelector('.table-container');
            if (table) {
                table.scrollIntoView({ behavior: 'smooth', block: 'center' });
            }
        });

        // Adiciona efeito de loading suave
        window.addEventListener('beforeunload', function() {
            document.body.style.opacity = '0.7';
        });
    </script>
</body>
</html>